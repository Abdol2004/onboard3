<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
 <title><%= title %></title>
 <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
 <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
 <%- include('../partials/achievement-popup') %>
 <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
<div class="grid-bg"></div>
<%- include('../partials/sidebar', { user, currentPage, pathwaySlug }) %>

<div class="dashboard-container">
<main class="main-content">

<header class="header">
 <div class="header-content">
 <div class="header-title">
 <h2><i class="fas fa-road" style="color:var(--green);margin-right:.5rem"></i>Career Paths</h2>
 <p>Choose your path and start learning</p>
 </div>
 </div>
</header>

<div class="content" style="padding:1.5rem;max-width:900px">

 <% if (!user.pathway) { %>
 <div style="background:rgba(94,194,19,.06);border:1px solid rgba(94,194,19,.2);border-radius:14px;padding:1rem 1.25rem;margin-bottom:1.5rem;display:flex;align-items:center;gap:.875rem">
 <i class="fas fa-circle-info" style="color:var(--green);font-size:1rem;flex-shrink:0"></i>
 <p style="font-size:.85rem;color:var(--text-2)">You haven't selected a pathway yet. <a href="/dashboard" style="color:var(--green);font-weight:700;text-decoration:none">Go to dashboard</a> to choose yours and unlock your community.</p>
 </div>
 <% } %>

 <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(380px,1fr));gap:1.25rem">
 <% PATHWAYS.forEach(pw => {
 const m = PATHWAY_META[pw];
 const cfg = cfgMap[pw] || {};
 const cnt = cntMap[pw] || 0;
 const live = liveSet.includes(pw);
 const lead = cfg.leadUserId ? leadMap[cfg.leadUserId.toString()] : null;
 const isMyPath = user.pathway === pw;
 %>
 <a href="/dashboard/career-paths/<%= pw %>" style="text-decoration:none;display:block">
 <div style="border-radius:18px;border:1px solid <%= isMyPath ? m.border : 'var(--border)' %>;background:<%= isMyPath ? m.bg : 'rgba(255,255,255,.025)' %>;padding:1.5rem;transition:all .25s;cursor:pointer;position:relative;overflow:hidden"
 onmouseover="this.style.borderColor='<%= m.border %>';this.style.background='<%= m.bg %>'"
 onmouseout="this.style.borderColor='<%= isMyPath ? m.border : 'var(--border)' %>';this.style.background='<%= isMyPath ? m.bg : 'rgba(255,255,255,.025)' %>'">

 <% if (live) { %>
 <div style="position:absolute;top:1rem;right:1rem;display:flex;align-items:center;gap:.375rem;background:rgba(239,68,68,.15);border:1px solid rgba(239,68,68,.35);border-radius:99px;padding:.2rem .625rem">
 <span style="width:7px;height:7px;border-radius:50%;background:#ef4444;animation:livePulse 1.4s ease-in-out infinite"></span>
 <span style="font-size:.65rem;font-weight:800;color:#ef4444;letter-spacing:.8px">LIVE</span>
 </div>
 <% } %>

 <% if (isMyPath) { %>
 <div style="position:absolute;top:1rem;right:<%= live ? '5rem' : '1rem' %>;background:<%= m.color %>22;border:1px solid <%= m.border %>;border-radius:99px;padding:.2rem .625rem">
 <span style="font-size:.65rem;font-weight:800;color:<%= m.color %>;letter-spacing:.5px">YOUR PATH</span>
 </div>
 <% } %>

 <div style="display:flex;align-items:center;gap:.875rem;margin-bottom:1rem">
 <div style="width:46px;height:46px;border-radius:13px;background:<%= m.bg %>;border:1px solid <%= m.border %>;display:flex;align-items:center;justify-content:center;flex-shrink:0">
 <i class="fas <%= m.icon %>" style="color:<%= m.color %>;font-size:1.125rem"></i>
 </div>
 <div>
 <h3 style="font-size:1rem;font-weight:800;color:var(--text);margin-bottom:.15rem"><%= m.name %></h3>
 <p style="font-size:.75rem;color:var(--text-3)"><%= cfg.tagline || m.tagline %></p>
 </div>
 </div>

 <% if (lead) { %>
 <div style="display:flex;align-items:center;gap:.625rem;margin-bottom:.875rem;padding:.625rem;border-radius:10px;background:rgba(255,255,255,.04)">
 <% if (lead.profilePicture) { %>
 <img src="<%= lead.profilePicture %>" style="width:28px;height:28px;border-radius:50%;object-fit:cover;flex-shrink:0" alt="">
 <% } else { %>
 <div style="width:28px;height:28px;border-radius:50%;background:<%= m.bg %>;border:1px solid <%= m.border %>;display:flex;align-items:center;justify-content:center;font-size:.7rem;font-weight:800;color:<%= m.color %>;flex-shrink:0"><%= lead.username.charAt(0).toUpperCase() %></div>
 <% } %>
 <div>
 <p style="font-size:.72rem;font-weight:700;color:var(--text-2)"><%= cfg.leadName || lead.username %></p>
 <p style="font-size:.65rem;color:var(--text-3)">Pathway Lead</p>
 </div>
 </div>
 <% } %>

 <div style="display:flex;align-items:center;justify-content:space-between">
 <span style="font-size:.75rem;color:var(--text-3)"><%= cnt %> resource<%= cnt !== 1 ? 's' : '' %></span>
 <span style="font-size:.78rem;font-weight:700;color:<%= m.color %>">View Pathway <i class="fas fa-arrow-right" style="font-size:.65rem"></i></span>
 </div>
 </div>
 </a>
 <% }) %>
 </div>
</div>

</main>
</div>

<style>
@keyframes livePulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.5;transform:scale(1.3)} }
</style>

</body>
</html>
