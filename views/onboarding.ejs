<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome to ONBOARD3</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --green:#5EC213; --green-dark:#45960E; --green-light:#78E02A;
            --bg:#0F1610; --bg-card:rgba(18,28,18,0.94); --border:rgba(94,194,19,0.18);
            --text:#E8F5E2; --text-2:#8AAF85; --text-3:#5A7A56;
        }
        body { font-family:'Outfit',sans-serif; background:var(--bg); color:var(--text); min-height:100vh; -webkit-font-smoothing:antialiased; overflow-x:hidden; }

        /* BG */
        .ob-bg { position:fixed;inset:0;z-index:0;pointer-events:none;background-image:linear-gradient(var(--border) 1px,transparent 1px),linear-gradient(90deg,var(--border) 1px,transparent 1px);background-size:52px 52px;opacity:.35; }
        .ob-orb { position:fixed;border-radius:50%;filter:blur(90px);pointer-events:none;z-index:0; }
        .ob-orb-1 { width:500px;height:500px;top:-120px;right:-120px;background:radial-gradient(circle,rgba(94,194,19,.12),transparent 65%);animation:orbF 14s ease-in-out infinite; }
        .ob-orb-2 { width:380px;height:380px;bottom:-80px;left:-80px;background:radial-gradient(circle,rgba(94,194,19,.08),transparent 65%);animation:orbF 18s ease-in-out infinite reverse; }
        @keyframes orbF{0%,100%{transform:translate(0,0)}50%{transform:translate(30px,20px)}}
        .particles{position:fixed;inset:0;pointer-events:none;z-index:0;overflow:hidden;}
        .particle{position:absolute;background:var(--green);border-radius:50%;animation:pFloat linear infinite;filter:blur(1px);}
        @keyframes pFloat{0%{transform:translateY(0) scale(1);opacity:inherit}50%{transform:translateY(-80px) translateX(15px) scale(1.3)}100%{transform:translateY(-180px) translateX(-5px) scale(.8);opacity:0}}

        /* Progress */
        .ob-topbar { position:fixed;top:0;left:0;right:0;z-index:100;padding:0.875rem 1.5rem;display:flex;align-items:center;gap:1rem; }
        .ob-progress-track { flex:1;height:4px;background:rgba(255,255,255,.07);border-radius:99px;overflow:hidden; }
        .ob-progress-fill { height:100%;background:linear-gradient(90deg,var(--green-dark),var(--green),var(--green-light));box-shadow:0 0 12px rgba(94,194,19,.6);transition:width .6s cubic-bezier(.4,0,.2,1); }
        .ob-step-count { font-size:.78rem;font-weight:800;color:var(--text-3);white-space:nowrap; }

        /* Layout */
        .ob-wrap { position:relative;z-index:1;min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:5rem 1.25rem 2rem; }
        .ob-step { display:none;width:100%;max-width:660px;animation:stepIn .5s cubic-bezier(.4,0,.2,1) both; }
        .ob-step.active { display:block; }
        @keyframes stepIn{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}

        /* Card */
        .ob-card { background:var(--bg-card);border:1px solid var(--border);border-radius:24px;padding:2.25rem;backdrop-filter:blur(20px);box-shadow:0 24px 80px rgba(0,0,0,.4),0 0 0 1px rgba(94,194,19,.05); }
        @media(max-width:500px){.ob-card{padding:1.5rem 1.25rem;border-radius:18px;}}

        /* Typography */
        .ob-eyebrow { font-size:.7rem;font-weight:800;letter-spacing:3px;text-transform:uppercase;color:var(--green);margin-bottom:.75rem;display:flex;align-items:center;gap:.625rem; }
        .ob-eyebrow::after { content:'';flex:1;height:1px;background:rgba(94,194,19,.2); }
        .ob-h1 { font-size:clamp(1.625rem,4vw,2.375rem);font-weight:900;letter-spacing:-1.2px;line-height:1.12;color:var(--text);margin-bottom:.75rem; }
        .ob-h1 span { color:var(--green); }
        .ob-p { font-size:.9375rem;color:var(--text-2);line-height:1.75;margin-bottom:1.5rem; }

        /* Logo */
        .ob-logo { width:80px;height:80px;border-radius:20px;background:rgba(94,194,19,.12);border:2px solid rgba(94,194,19,.35);display:flex;align-items:center;justify-content:center;overflow:hidden;box-shadow:0 0 40px rgba(94,194,19,.2);margin:0 auto 1.5rem;animation:logoPop .7s cubic-bezier(.34,1.56,.64,1) both .2s; }
        @keyframes logoPop{from{opacity:0;transform:scale(.5)}to{opacity:1;transform:scale(1)}}
        .ob-logo img { width:100%;height:100%;object-fit:contain; }

        /* Stats row */
        .ob-stats { display:grid;grid-template-columns:repeat(3,1fr);gap:.75rem;margin-bottom:1.75rem; }
        .ob-stat { text-align:center;padding:.875rem;border-radius:13px;background:rgba(94,194,19,.06);border:1px solid rgba(94,194,19,.15); }
        .ob-stat-v { font-size:1.375rem;font-weight:900;color:var(--green);letter-spacing:-.5px; }
        .ob-stat-l { font-size:.68rem;font-weight:700;color:var(--text-3);text-transform:uppercase;letter-spacing:.8px;margin-top:2px; }

        /* Pathway cards */
        .pathway-grid { display:flex;flex-direction:column;gap:.75rem;margin-bottom:1.5rem; }
        .pathway-card { display:flex;align-items:center;gap:1.125rem;padding:1.125rem 1.25rem;border-radius:16px;background:rgba(255,255,255,.025);border:2px solid var(--border);cursor:pointer;transition:all .3s cubic-bezier(.4,0,.2,1);position:relative;overflow:hidden; }
        .pathway-card::before { content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(94,194,19,.06),transparent);opacity:0;transition:opacity .3s; }
        .pathway-card:hover { border-color:rgba(94,194,19,.4);transform:translateX(4px); }
        .pathway-card:hover::before { opacity:1; }
        .pathway-card.selected { border-color:var(--green);background:rgba(94,194,19,.08);box-shadow:0 0 0 3px rgba(94,194,19,.12),0 8px 30px rgba(94,194,19,.1); }
        .pathway-card.selected::before { opacity:1; }
        .pw-icon { width:50px;height:50px;border-radius:13px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:1.25rem;transition:transform .3s; }
        .pathway-card:hover .pw-icon { transform:scale(1.12) rotate(-5deg); }
        .pw-icon--jobs     { background:rgba(251,191,36,.15);color:#fbbf24; }
        .pw-icon--ai       { background:rgba(168,85,247,.15);color:#c084fc; }
        .pw-icon--building { background:rgba(59,130,246,.15);color:#60a5fa; }
        .pw-body { flex:1;min-width:0; }
        .pw-name { font-size:1rem;font-weight:800;color:var(--text);margin-bottom:.2rem;letter-spacing:-.2px; }
        .pw-desc { font-size:.8125rem;color:var(--text-2);line-height:1.55; }
        .pw-check { width:24px;height:24px;border-radius:50%;border:2px solid var(--border);display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all .3s;font-size:.7rem; }
        .pathway-card.selected .pw-check { background:var(--green);border-color:var(--green);color:#000; }

        /* Education cards */
        .edu-grid { display:grid;grid-template-columns:1fr 1fr;gap:.75rem;margin-bottom:1.5rem; }
        @media(max-width:480px){.edu-grid{grid-template-columns:1fr;}}
        .edu-card { padding:1.125rem;border-radius:14px;background:rgba(255,255,255,.025);border:1px solid var(--border);transition:border-color .25s; }
        .edu-card:hover { border-color:rgba(94,194,19,.25); }
        .edu-icon { width:40px;height:40px;border-radius:11px;background:rgba(94,194,19,.1);border:1px solid rgba(94,194,19,.2);display:flex;align-items:center;justify-content:center;font-size:.9rem;color:var(--green);margin-bottom:.75rem; }
        .edu-title { font-size:.875rem;font-weight:800;color:var(--text);margin-bottom:.35rem; }
        .edu-text  { font-size:.78rem;color:var(--text-2);line-height:1.65; }

        /* Task list */
        .ob-tasks { display:flex;flex-direction:column;gap:.625rem;margin-bottom:1.5rem; }
        .ob-task { display:flex;align-items:center;gap:.875rem;padding:.875rem 1rem;border-radius:13px;background:rgba(255,255,255,.025);border:1px solid var(--border);transition:all .25s; }
        .ob-task.done { background:rgba(94,194,19,.06);border-color:rgba(94,194,19,.3); }
        .ob-task.done .ob-task-tick { background:var(--green);border-color:var(--green);color:#000; }
        .ob-task-icon { width:38px;height:38px;border-radius:10px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:.9rem; }
        .ob-task-icon--x  { background:rgba(255,255,255,.08);color:var(--text); }
        .ob-task-icon--tg { background:rgba(29,161,242,.15);color:#1d9bf0; }
        .ob-task-icon--sol{ background:rgba(251,146,60,.15);color:#fb923c; }
        .ob-task-icon--eye{ background:rgba(94,194,19,.12);color:var(--green); }
        .ob-task-icon--share { background:rgba(168,85,247,.12);color:#c084fc; }
        .ob-task-body { flex:1;min-width:0; }
        .ob-task-t { font-size:.875rem;font-weight:700;color:var(--text); }
        .ob-task-s { font-size:.72rem;color:var(--text-3);margin-top:1px; }
        .ob-task-tick { width:24px;height:24px;border-radius:50%;border:2px solid var(--border);display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all .3s;font-size:.7rem;color:transparent; }
        .ob-task-btn { font-size:.78rem;font-weight:800;padding:.45rem .9rem;border-radius:9px;border:none;cursor:pointer;font-family:'Outfit',sans-serif;transition:all .25s;white-space:nowrap;flex-shrink:0; }
        .ob-task-btn--go   { background:rgba(94,194,19,.12);color:var(--green);border:1px solid rgba(94,194,19,.3); }
        .ob-task-btn--go:hover { background:rgba(94,194,19,.2); }
        .ob-task-btn--done { background:rgba(94,194,19,.12);color:var(--green);border:1px solid rgba(94,194,19,.3);cursor:default; }

        /* Post template */
        .post-box { background:rgba(255,255,255,.025);border:1px solid var(--border);border-radius:13px;padding:1rem;margin-bottom:.75rem; }
        .post-box-head { display:flex;align-items:center;justify-content:space-between;margin-bottom:.625rem; }
        .post-box-head span { font-size:.72rem;font-weight:700;color:var(--text-3);text-transform:uppercase;letter-spacing:1px; }
        .post-box-head button { font-size:.72rem;font-weight:800;padding:.3rem .7rem;border-radius:7px;border:1px solid rgba(94,194,19,.3);background:rgba(94,194,19,.08);color:var(--green);cursor:pointer;font-family:'Outfit',sans-serif;transition:all .2s; }
        .post-box-head button:hover { background:rgba(94,194,19,.18); }
        .post-text { font-size:.8375rem;color:var(--text-2);line-height:1.7;word-break:break-word; }

        /* Form */
        .ob-form { display:flex;flex-direction:column;gap:.875rem;margin-bottom:1.5rem; }
        .ob-input-wrap { position:relative; }
        .ob-iicon { position:absolute;left:1rem;top:50%;transform:translateY(-50%);font-size:.8rem;color:var(--text-3);pointer-events:none;transition:color .25s; }
        .ob-input-wrap:focus-within .ob-iicon { color:var(--green); }
        .ob-input { width:100%;padding:.875rem 1rem .875rem 2.75rem;background:rgba(94,194,19,.04);border:1.5px solid var(--border);border-radius:13px;color:var(--text);font-family:'Outfit',sans-serif;font-size:.9375rem;transition:all .3s; }
        .ob-input::placeholder { color:var(--text-3); }
        .ob-input:focus { outline:none;border-color:var(--green);background:rgba(94,194,19,.07);box-shadow:0 0 0 3px rgba(94,194,19,.12); }

        /* PFP */
        .pfp-row { display:flex;align-items:center;gap:1.125rem;margin-bottom:.25rem; }
        .pfp-prev { width:68px;height:68px;border-radius:17px;flex-shrink:0;background:linear-gradient(135deg,var(--green),var(--green-dark));display:flex;align-items:center;justify-content:center;font-size:1.625rem;font-weight:900;color:#000;overflow:hidden;border:2px solid rgba(94,194,19,.35);box-shadow:0 4px 18px rgba(94,194,19,.28); }
        .pfp-prev img { width:100%;height:100%;object-fit:cover;border-radius:15px; }
        .pfp-upload { flex:1;padding:.875rem;border-radius:13px;border:2px dashed rgba(94,194,19,.3);background:rgba(94,194,19,.03);cursor:pointer;text-align:center;transition:all .25s;font-family:'Outfit',sans-serif; }
        .pfp-upload:hover { border-color:var(--green);background:rgba(94,194,19,.07); }
        .pfp-upload p { font-size:.875rem;font-weight:700;color:var(--text-2);margin-bottom:.2rem; }
        .pfp-upload small { font-size:.72rem;color:var(--text-3); }

        /* Reward */
        .reward-wrap { text-align:center;padding:1.25rem 0; }
        .reward-icon-ring { width:100px;height:100px;border-radius:50%;background:rgba(94,194,19,.12);border:2px solid rgba(94,194,19,.4);display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;font-size:2.5rem;color:var(--green);box-shadow:0 0 40px rgba(94,194,19,.3);animation:rewardRing .7s cubic-bezier(.34,1.56,.64,1) both .3s; }
        @keyframes rewardRing{from{opacity:0;transform:scale(.4)}to{opacity:1;transform:scale(1)}}
        .reward-amount { font-size:clamp(2.5rem,8vw,3.5rem);font-weight:900;letter-spacing:-2px;color:var(--green);line-height:1;filter:drop-shadow(0 0 24px rgba(94,194,19,.55));animation:rPop .6s cubic-bezier(.34,1.56,.64,1) both .6s; }
        @keyframes rPop{from{opacity:0;transform:scale(.5)}to{opacity:1;transform:scale(1)}}
        .reward-lbl { font-size:.9rem;color:var(--text-2);margin-top:.4rem;font-weight:600; }
        .reward-stars { display:flex;justify-content:center;gap:.3rem;margin:.875rem 0;font-size:1.25rem;color:#fbbf24; }
        .reward-stars i { animation:starPop .4s cubic-bezier(.34,1.56,.64,1) both; }
        .reward-stars i:nth-child(2){animation-delay:.08s} .reward-stars i:nth-child(3){animation-delay:.16s} .reward-stars i:nth-child(4){animation-delay:.24s} .reward-stars i:nth-child(5){animation-delay:.32s}
        @keyframes starPop{from{opacity:0;transform:scale(0)}to{opacity:1;transform:scale(1)}}

        /* Buttons */
        .ob-btn { width:100%;padding:1rem;border-radius:14px;border:none;cursor:pointer;font-family:'Outfit',sans-serif;font-size:.9375rem;font-weight:800;letter-spacing:.2px;transition:all .35s cubic-bezier(.4,0,.2,1);display:flex;align-items:center;justify-content:center;gap:.6rem;position:relative;overflow:hidden; }
        .ob-btn--primary { background:linear-gradient(135deg,var(--green) 0%,var(--green-dark) 100%);color:#000;box-shadow:0 6px 28px rgba(94,194,19,.4); }
        .ob-btn--primary::before { content:'';position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(255,255,255,.2),transparent);transform:translateX(-100%);transition:transform .55s; }
        .ob-btn--primary:hover::before { transform:translateX(100%); }
        .ob-btn--primary:hover { transform:translateY(-2px);box-shadow:0 12px 44px rgba(94,194,19,.58); }
        .ob-btn--primary:disabled { opacity:.6;cursor:not-allowed;transform:none; }
        .ob-btn--outline { background:transparent;color:var(--text-2);border:1.5px solid rgba(255,255,255,.1); }
        .ob-btn--outline:hover { border-color:rgba(94,194,19,.3);color:var(--text); }
        .ob-btn-row { display:flex;gap:.75rem;margin-top:.375rem; }
        .ob-btn-row .ob-btn { flex:1; }
        .ob-skip { text-align:center;margin-top:.875rem;font-size:.8rem;color:var(--text-3);cursor:pointer;transition:color .2s; }
        .ob-skip:hover { color:var(--text-2); }

        /* Notice box */
        .ob-notice { display:flex;align-items:flex-start;gap:.75rem;padding:.875rem 1rem;border-radius:12px;background:rgba(94,194,19,.06);border:1px solid rgba(94,194,19,.2);margin-bottom:1.25rem; }
        .ob-notice i { color:var(--green);font-size:.9rem;flex-shrink:0;margin-top:1px; }
        .ob-notice-text { font-size:.8125rem;color:var(--text-2);line-height:1.65; }
        .ob-notice-text strong { color:var(--green); }
    </style>
</head>
<body>
    <div class="ob-bg"></div>
    <div class="ob-orb ob-orb-1"></div>
    <div class="ob-orb ob-orb-2"></div>
    <div class="particles" id="particles"></div>

    <!-- Top progress bar -->
    <div class="ob-topbar">
        <div class="ob-progress-track"><div class="ob-progress-fill" id="progFill" style="width:0%"></div></div>
        <div class="ob-step-count" id="stepCount">1 / 7</div>
    </div>

    <div class="ob-wrap">

        <!-- ══ STEP 0: WELCOME ══ -->
        <div class="ob-step active" id="step0">
            <div class="ob-card" style="text-align:center">
                <div class="ob-logo"><img src="/img/logo.png" alt="ONBOARD3"></div>
                <% if (isLaunchDay) { %>
                <div class="ob-eyebrow" style="justify-content:center;color:#fbbf24"><i class="fas fa-gift" style="color:#fbbf24"></i> Launch Day Reward</div>
                <h1 class="ob-h1">We are <span>LIVE</span> 🎉</h1>
                <p class="ob-p">Complete these quick tasks and <strong style="color:var(--green)">claim your USDC reward</strong> — we have 39,900 builders and we want the reward to reach everybody. It's free. Earn more through quests and bounties!</p>
                <div style="padding:.875rem 1rem;border-radius:12px;background:rgba(251,191,36,.08);border:1px solid rgba(251,191,36,.25);margin-bottom:1.25rem">
                    <div style="font-size:.75rem;font-weight:800;color:#fbbf24;text-transform:uppercase;letter-spacing:.08em;margin-bottom:.25rem">Your reward is waiting</div>
                    <div style="font-size:1rem;color:var(--text-2);font-size:.875rem">Complete all steps → see your reward on the final screen</div>
                </div>
                <button class="ob-btn ob-btn--primary" onclick="goStep(1)">
                    <i class="fas fa-gift"></i> Claim My Reward
                </button>
                <% } else { %>
                <div class="ob-eyebrow" style="justify-content:center">Welcome</div>
                <h1 class="ob-h1">Hey <span><%= user.username %></span>,<br>you're officially in.</h1>
                <p class="ob-p">ONBOARD3 is your gateway into Web3 — real quests, IRL events, community, and actual rewards. We're a movement, not just an app.</p>
                <div class="ob-stats">
                    <div class="ob-stat"><div class="ob-stat-v">5K+</div><div class="ob-stat-l">Builders</div></div>
                    <div class="ob-stat"><div class="ob-stat-v">$6.8K</div><div class="ob-stat-l">Paid Out</div></div>
                    <div class="ob-stat"><div class="ob-stat-v">20+</div><div class="ob-stat-l">Quests</div></div>
                </div>
                <button class="ob-btn ob-btn--primary" onclick="goStep(1)">
                    <i class="fas fa-rocket"></i> Start My Journey
                </button>
                <% } %>
            </div>
        </div>

        <!-- ══ STEP 1: PATHWAY ══ -->
        <div class="ob-step" id="step1">
            <div class="ob-card">
                <div class="ob-eyebrow"><i class="fas fa-map-signs"></i> Your Path</div>
                <h1 class="ob-h1">Choose your<br><span>main focus</span></h1>
                <p class="ob-p" style="margin-bottom:1.25rem">Pick the path that fits your goals. This shapes your quests and community connections.</p>
                <div class="pathway-grid">
                    <div class="pathway-card" id="path-web3_jobs" onclick="selectPathway('web3_jobs')">
                        <div class="pw-icon pw-icon--jobs"><i class="fas fa-briefcase"></i></div>
                        <div class="pw-body">
                            <div class="pw-name">Web3 Jobs</div>
                            <div class="pw-desc">Land remote roles, freelance gigs, and full-time positions in Web3 worldwide.</div>
                        </div>
                        <div class="pw-check" id="chk-web3_jobs"><i class="fas fa-check"></i></div>
                    </div>
                    <div class="pathway-card" id="path-ai" onclick="selectPathway('ai')">
                        <div class="pw-icon pw-icon--ai"><i class="fas fa-microchip"></i></div>
                        <div class="pw-body">
                            <div class="pw-name">AI & Web3</div>
                            <div class="pw-desc">Explore how artificial intelligence is reshaping blockchain and decentralized tech.</div>
                        </div>
                        <div class="pw-check" id="chk-ai"><i class="fas fa-check"></i></div>
                    </div>
                    <div class="pathway-card" id="path-building" onclick="selectPathway('building')">
                        <div class="pw-icon pw-icon--building"><i class="fas fa-code"></i></div>
                        <div class="pw-body">
                            <div class="pw-name">Building</div>
                            <div class="pw-desc">Ship Web3 products, learn smart contracts, and build real on-chain applications.</div>
                        </div>
                        <div class="pw-check" id="chk-building"><i class="fas fa-check"></i></div>
                    </div>
                    <div class="pathway-card" id="path-nft" onclick="selectPathway('nft')">
                        <div class="pw-icon" style="background:rgba(236,72,153,.15);color:#f472b6"><i class="fas fa-image"></i></div>
                        <div class="pw-body">
                            <div class="pw-name">NFTs & Digital Assets</div>
                            <div class="pw-desc">Explore NFT creation, collecting, trading, and the creator economy on-chain.</div>
                        </div>
                        <div class="pw-check" id="chk-nft"><i class="fas fa-check"></i></div>
                    </div>
                    <div class="pathway-card" id="path-trading" onclick="selectPathway('trading')">
                        <div class="pw-icon" style="background:rgba(16,185,129,.15);color:#10b981"><i class="fas fa-chart-line"></i></div>
                        <div class="pw-body">
                            <div class="pw-name">Trading</div>
                            <div class="pw-desc">Master crypto trading, DeFi strategies, on-chain analysis, and portfolio management.</div>
                        </div>
                        <div class="pw-check" id="chk-trading"><i class="fas fa-check"></i></div>
                    </div>
                </div>

                <!-- Application form (shown for <10k XP users) -->
                <div id="pathwayAppForm" style="display:none;margin-top:1rem;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.1);border-radius:16px;padding:1.375rem">
