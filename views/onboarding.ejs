    ];
    const eyePosts = [
        `Hey everyone! Just joined from @onboard3___ and I'm ready to find a team and start earning! Let's build together. #EyeCoin`,
        `Jumping in from @onboard3___ — new here but motivated to grind! Anyone looking for a team member? #EyeCoin`,
        `Just discovered @eyecoinHQ through @onboard3___ — loving the concept! Ready to join a team and start playing. #EyeCoin`,
        `Sent here by @onboard3___ and I'm ready to compete! Looking for an active team — who's recruiting? #EyeCoin`,
        `Onboarded via @onboard3___. I'm new to EyeCoin but not new to grinding. Ready to join a team and make money! #EyeCoin`
    ];

    function randPost(arr) { return arr[Math.floor(Math.random() * arr.length)]; }
    let chosenSolPost = randPost(solPosts);
    let chosenEyePost = randPost(eyePosts);

    /* ── Navigation ── */
    function goStep(n) {
        document.getElementById('step'+cur).classList.remove('active');
        cur = n;
        document.getElementById('step'+n).classList.add('active');
        updateProgress();
        window.scrollTo({top:0,behavior:'smooth'});
        if (n === 4) initSolflare();
        if (n === 5) initEyeCoin();
        if (n === 7 && !rewardDone) completeOnboarding();
    }

    function updateProgress() {
        const pct = (cur / (TOTAL - 1)) * 100;
        document.getElementById('progFill').style.width = pct + '%';
        document.getElementById('stepCount').textContent = (cur + 1) + ' / ' + TOTAL;
    }

    /* ── Pathway ── */
    var pathwayApprovalMode = '<%= pathwayApprovalMode %>';

    function selectPathway(key) {
        selectedPathway = key;
        document.querySelectorAll('.pathway-card').forEach(c => c.classList.remove('selected'));
        document.getElementById('path-'+key).classList.add('selected');
        document.getElementById('pathBtn').disabled = false;
        document.getElementById('pathwayAppForm').style.display = 'none';
        document.getElementById('pathBtn').style.display = '';
    }
    async function confirmPathway() {
        if (!selectedPathway) return;
        if (pathwayApprovalMode === 'manual') {
            document.getElementById('pathwayAppForm').style.display = '';
            document.getElementById('pathBtn').style.display = 'none';
            return;
        }
        try { await fetch('/onboarding/pathway',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({pathway:selectedPathway})}); } catch(_){}
        goStep(2);
    }
    function hideAppForm() {
        document.getElementById('pathwayAppForm').style.display = 'none';
        document.getElementById('pathBtn').style.display = '';
    }
    async function submitPathwayApplication() {
        var reason     = (document.getElementById('appReason').value || '').trim();
        var experience = (document.getElementById('appExperience').value || '').trim();
        if (!reason || !experience) { alert('Please fill in both fields before submitting.'); return; }
        try {
            await fetch('/onboarding/pathway', {
                method:'POST', headers:{'Content-Type':'application/json'},
                body: JSON.stringify({ pathway: selectedPathway, reason, experience })
            });
        } catch(_) {}
        goStep(2);
    }

    /* ── Tasks — track clicked state for gate checks ── */
    const _clicked = {};
    function doTask(id, url) {
        _clicked[id] = true;
        window.open(url, '_blank');
        setTimeout(() => {
            const el = document.getElementById(id);
            if (!el) return;
            el.classList.add('done');
            const btn = el.querySelector('.ob-task-btn');
            if (btn) { btn.className = 'ob-task-btn ob-task-btn--done'; btn.textContent = 'Done'; }
            // Unlock Next button if all required tasks for this step are done
            checkStepGate(cur);
        }, 1800);
    }

    /* Required task IDs per step — driven by server config so removals take effect immediately */
    const REQUIRED = {
        3: <%- JSON.stringify(_step3.map(function(tk){ return tk.taskId; })) %>,
        5: [],
        6: []
    };

    function checkStepGate(step) {
        const req = REQUIRED[step];
        if (!req || req.length === 0) return;
        const allDone = req.every(id => document.getElementById(id)?.classList.contains('done'));
        const btn = document.getElementById('nextBtn' + step);
        if (btn) {
            btn.disabled = !allDone;
            btn.style.opacity = allDone ? '1' : '0.45';
            btn.style.cursor  = allDone ? 'pointer' : 'not-allowed';
            if (allDone) btn.style.boxShadow = '0 6px 24px rgba(94,194,19,0.5)';
        }
    }

    function requireStep(step, nextStep) {
        const req = REQUIRED[step];
        if (!req || req.length === 0) { goStep(nextStep); return; }
        const pending = req.filter(id => !document.getElementById(id)?.classList.contains('done'));
        if (pending.length > 0) {
            showToast('Please complete all required tasks first', 'warning');
            // Shake the pending tasks
            pending.forEach(id => {
                const el = document.getElementById(id);
                if (el) {
                    el.style.transition = 'all .1s';
                    el.style.transform = 'translateX(8px)';
                    el.style.borderColor = 'rgba(239,68,68,0.5)';
                    setTimeout(() => { el.style.transform = 'translateX(-8px)'; }, 100);
                    setTimeout(() => { el.style.transform = 'translateX(0)'; el.style.borderColor = ''; }, 200);
                }
            });
            return;
        }
        goStep(nextStep);
    }

    // Global toast fallback if sidebar isn't loaded yet
    if (!window.showToast) {
        window.showToast = function(msg, type) {
            const t = document.createElement('div');
            t.style.cssText = 'position:fixed;top:1.5rem;right:1.5rem;z-index:99999;padding:.875rem 1.25rem;border-radius:14px;font-family:Outfit,sans-serif;font-size:.875rem;font-weight:600;color:#fbbf24;background:rgba(20,16,8,.97);border:1px solid rgba(251,191,36,.4);box-shadow:0 12px 40px rgba(0,0,0,.4)';
            t.textContent = msg;
            document.body.appendChild(t);
            setTimeout(() => t.remove(), 3500);
        };
    }

    /* ── Solflare init ── */
    function initSolflare() {
        document.getElementById('solPost').textContent = chosenSolPost;
    }
    function shareWalletPost() {
        const txt = encodeURIComponent(chosenSolPost);
        window.open('https://x.com/intent/tweet?text=' + txt, '_blank');
        setTimeout(() => {
            const t = document.getElementById('t-sol-share');
            if (t) {
                t.classList.add('done');
                const btn = document.getElementById('solShareBtn');
                if (btn) { btn.className = 'ob-task-btn ob-task-btn--done'; btn.textContent = 'Shared'; }
            }
        }, 1800);
    }

    /* ── EyeCoin init ── */
    function initEyeCoin() {
        document.getElementById('eyePost').textContent = chosenEyePost;
    }

    /* ── Copy post ── */
    function copyPost(id) {
        const txt = document.getElementById(id).textContent;
        navigator.clipboard.writeText(txt).catch(() => {});
        event.target.textContent = 'Copied!';
        setTimeout(() => event.target.textContent = 'Copy', 2000);
    }

    /* ── PFP ── */
    function handlePfp(input) {
        const file = input.files[0]; if (!file) return;
        if (file.size > 620000) { showToast('Image too large. Max 600KB.', 'warning'); return; }
        const reader = new FileReader();
        reader.onload = e => {
            pfpBase64 = e.target.result;
            const prev = document.getElementById('pfpPrev');
            prev.innerHTML = `<img src="${pfpBase64}" alt="PFP">`;
        };
        reader.readAsDataURL(file);
    }

    /* ── Save identity + go to reward ── */
    async function saveAndClaim() {
        const data = {
            twitter: document.getElementById('ob_tw').value.trim(),
            bio:     document.getElementById('ob_bio').value.trim(),
            github:  document.getElementById('ob_gh').value.trim()
        };
        const w = document.getElementById('ob_wallet').value.trim();
        if (w) data.walletAddress = w;
        if (pfpBase64) data.profilePicture = pfpBase64;
        try { await fetch('/onboarding/profile',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)}); } catch(_){}
        goStep(7);
    }

    /* ── Complete onboarding ── */
    async function completeOnboarding() {
        rewardDone = true;
        try {
            const r = await fetch('/onboarding/complete',{method:'POST',headers:{'Content-Type':'application/json'}});
            const d = await r.json();
            if (d.success) {
                setTimeout(() => {
                    animateReward(d.reward);
                    showPathwayBox();
                }, 500);
            }
        } catch(_) {
            setTimeout(() => { animateReward(0.1); showPathwayBox(); }, 800);
        }
    }

    function animateReward(target) {
        const el = document.getElementById('rewardAmt');
        const dur = 1400; const start = performance.now();
        function tick(now) {
            const t = Math.min(1,(now-start)/dur);
            const ease = 1 - Math.pow(1-t,3);
            el.textContent = '$' + (ease * target).toFixed(2);
            if (t < 1) requestAnimationFrame(tick); else el.textContent = '$' + target.toFixed(2);
        }
        requestAnimationFrame(tick);
    }

    function showPathwayBox() {
        if (!selectedPathway) return;
        const m = pathwayMeta[selectedPathway];
        document.getElementById('pathwayBoxInner').innerHTML = `<i class="fas ${m.icon}" style="color:${m.color}"></i> <span style="color:${m.color}">${m.name}</span>`;
    }

    updateProgress();
    </script>
</body>
</html>
